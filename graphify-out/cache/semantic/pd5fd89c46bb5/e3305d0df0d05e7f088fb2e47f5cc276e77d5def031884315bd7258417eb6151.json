{"nodes": [{"id": "public_uploads_1782895401493_logo_logo_mark", "label": "Uploaded Team Logo Mark (Manta Ray Silhouette)", "file_type": "image", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_uploads_1782895401493_logo_manta_ray_motif", "label": "Manta Ray Motif", "file_type": "concept", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_uploads_1782895401493_logo_lime_accent_color", "label": "Lime / Chartreuse Brand Accent Color", "file_type": "concept", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_uploads_1782895401493_logo_transparent_flat_vector_style", "label": "Flat Single-Color Vector Style on Transparent Background", "file_type": "rationale", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mark is a single flat spot color with negative-space cutouts and no gradients or text, and it is stored as a transparent PNG. This keeps it legible when scaled down to a nav bar or favicon, lets it sit on either a light or dark page background without a plate, and avoids a separate light/dark asset pair."}, {"id": "public_uploads_1782895401493_logo_asv_team_identity", "label": "ASV Team Brand Identity", "file_type": "concept", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A marine ray reads as fast, agile and water-borne, which matches an autonomous surface vehicle team; the aggressive swept wing profile doubles as a vessel silhouette so one mark carries both the animal name and the craft."}, {"id": "public_uploads_1782895401493_logo_media_upload_asset", "label": "User-Uploaded Media Asset (timestamped filename)", "file_type": "concept", "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The `<epoch-ms>-<originalname>` filename shape indicates the file arrived through an upload handler that prefixes a timestamp to avoid collisions and overwrites, rather than being a hand-placed static asset."}], "edges": [{"source": "public_uploads_1782895401493_logo_logo_mark", "target": "public_uploads_1782895401493_logo_manta_ray_motif", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_uploads_1782895401493_logo_logo_mark", "target": "public_uploads_1782895401493_logo_lime_accent_color", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_uploads_1782895401493_logo_logo_mark", "target": "public_uploads_1782895401493_logo_transparent_flat_vector_style", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_uploads_1782895401493_logo_manta_ray_motif", "target": "public_uploads_1782895401493_logo_asv_team_identity", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "public/uploads/1782895401493-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_uploads_1782895401493_logo_lime_accent_color", "target": "public_uploads_1782895401493_logo_asv_team_identity", "relation": "conceptually_related_to", "confidence": "INF